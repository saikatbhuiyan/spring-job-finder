<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit Spring Boot's defaults: dependency versions, plugin config, -parameters flag, etc. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.shahabuddin</groupId>
    <artifactId>job-finder</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>job-finder</name>
    <description>Job-search backend built with Spring Boot</description>

    <properties>
        <java.version>25</java.version>
        <spring-modulith.version>2.2.0</spring-modulith.version>
        <!-- Not the newest release (8.23.0, published 2 days before it was evaluated): a release
             gets a few weeks in the wild before it's adopted here. -->
        <bucket4j.version>8.22.0</bucket4j.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- Test tooling outside Spring Boot's BOM (ADR 0015). Not the newest releases (JaCoCo 0.8.16 and
             PIT 1.30.2 were 4 and 3 weeks old when evaluated): JaCoCo 0.8.15 is the first with official
             Java 25 support. -->
        <jacoco.version>0.8.15</jacoco.version>
        <pitest.version>1.30.1</pitest.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <!-- Empty default, so the test JVM's "@{argLine}" resolves when JaCoCo doesn't set it
             (-Djacoco.skip=true, or running a single test from the IDE). -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Aligned versions for all Spring Modulith artifacts -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring MVC + embedded Tomcat + Jackson (JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator) for request DTOs: @Valid, @NotBlank, @Positive... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Data's paging types (Pageable, Sort, Page, PagedModel) as the internal currency between
             the API and use cases (ADR 0010). Only the core library: no persistence yet, and no Spring
             Data web auto-configuration (clients' paging input goes through PageQuery, not Pageable). -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- Rate limiting (ADR 0012): Bucket4j's token bucket, lock-free and with nanosecond refill
             precision; the same library has Redis backends for when the API runs on several
             instances. Per-client buckets live in a bounded Caffeine cache (version managed by Boot). -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Production-ready endpoints: /actuator/health, metrics, info... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Request correlation (ADR 0013): a W3C trace per request, its trace ID in every log line,
             in the X-Trace-Id header and in Problem Details. Boot's Micrometer Tracing auto-configuration
             with the OpenTelemetry bridge (which also provides the io.micrometer.tracing API we use).
             No exporter yet. Deliberately not spring-boot-starter-opentelemetry: it also brings the OTLP
             exporters, and its metrics registry pushed to http://localhost:4318 every minute with no
             configuration at all (measured). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <!-- Development only: automatic restart, LiveReload, dev-friendly defaults.
             runtime + optional: not a compile dependency, not passed on to other projects,
             and excluded from the packaged jar by spring-boot-maven-plugin. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Testing: JUnit, AssertJ, Spring test support for MVC and actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Waiting for asynchronous outcomes in tests (log lines, metrics) without fixed sleeps.
             Used directly, so declared directly (not relied on transitively); version managed by Boot. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Architecture enforcement: module boundaries (Spring Modulith) and
             layer rules inside modules (ArchUnit). See docs/adr/0001. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Adds `mvn spring-boot:run` and builds an executable jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- `mvn spring-boot:run` uses the dev profile; the packaged jar does not
                         (production must opt in explicitly with SPRING_PROFILES_ACTIVE=prod). -->
                    <profiles>
                        <profile>dev</profile>
                    </profiles>
                </configuration>
            </plugin>

            <!-- Sets the property org.mockito:mockito-core:jar to the jar's path, for the agent below. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Mockito as a declared Java agent. Without it Mockito attaches itself at runtime, which the
                 JDK warns "will be disallowed by default in a future release" (JEP 451); the build would
                 then break on a JDK upgrade. @{argLine} keeps JaCoCo's agent (set late, hence @{} not ${}).
                 -Xshare:off: Mockito's first inline mock appends to the boot class path, which makes the JVM
                 print "Sharing is only supported for boot loader classes" (harmless; measured with and
                 without the agent); class data sharing only speeds up JVM startup, so nothing is lost. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>

            <!-- Code coverage (ADR 0015): records which lines and branches the tests execute, writes
                 target/site/jacoco/index.html, and fails `mvn verify` below the floor. A floor, not a
                 target: it catches untested code being added; mutation testing (profile "mutation")
                 checks that the executed code is actually asserted on. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <!-- Just below what was measured when the floor was set
                                             (ADR 0015); raise it as coverage rises, never lower it. -->
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mutation testing (ADR 0015): `mvn clean -Pmutation verify` (clean: PIT mutates whatever is in
             target/classes, and an IDE compiling there leaves classes javac wouldn't produce). PIT makes small changes to the
             production code (a flipped condition, a removed call, a constant return value), one at a time,
             runs the tests that cover that line, and reports every change no test noticed: code that runs
             in the tests but whose behavior nothing asserts. The automated form of the manual "mutation
             check" every guard test gets. Minutes, not seconds, so not part of the default build. -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <!-- Runs JUnit Platform tests (JUnit 6 included; verified). -->
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>mutation-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <targetClasses>
                                <param>com.shahabuddin.jobfinder.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.shahabuddin.jobfinder.*</param>
                            </targetTests>
                            <excludedTestClasses>
                                <!-- Can't kill mutants: they check the code's structure, not its behavior. -->
                                <param>com.shahabuddin.jobfinder.architecture.*</param>
                                <!-- Starts the packaged app in child JVMs, which PIT's mutated classes never reach. -->
                                <param>com.shahabuddin.jobfinder.ProfileConfigurationTests</param>
                            </excludedTestClasses>
                            <threads>4</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
